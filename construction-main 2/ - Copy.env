# ========================================================
# FORZEX CONSTRUCTION - SECRET CONFIGURATION (.env)
# Backend loads secret keys securely from process.env
# ========================================================

PORT=3000

# Secret Google Satellite & GIS API Keys
GOOGLE_MAPS_API_KEY=AIzaSy_GoogleSatelliteKey_Secret_ExampleKey
GOOGLE_SATELLITE_API_KEY=AIzaSy_GoogleSatelliteKey_Secret_ExampleKey
GOOGLE_GIS_API_KEY=AIzaSy_GoogleGISKey_Secret_ExampleKey

# Firebase Backend & Storage Credentials
VITE_FIREBASE_API_KEY=AIzaSy_FirebaseApiKey_ExampleSecret
VITE_FIREBASE_AUTH_DOMAIN=forzex-construction.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=forzex-construction
VITE_FIREBASE_STORAGE_BUCKET=forzex-construction.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_DATABASE_URL=https://forzex-construction-default-rtdb.firebaseio.com

# OpenAI ChatGPT API Key (Get yours at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
